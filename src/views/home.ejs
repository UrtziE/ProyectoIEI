<%- include('partials/header') %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap');

    /* ===============================
       VARIABLES (MODO OSCURO JUEGO)
       =============================== */
    :root {
        --bg-color: #121212;
        --surface-color: #1e1e1e;
        --border-color: #2c2c2c;

        --text-main: #e5e5e5;
        --text-muted: #9aa0a6;

        --primary: #4f8cff;        /* Azul juego */
        --primary-hover: #6fa3ff;
        --secondary: #7c6cff;      /* Morado suave */
    }

    /* ===============================
       BODY
       =============================== */
    body {
        margin: 0;
        font-family: 'Nunito', sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
    }

    /* ===============================
       CONTENEDOR PRINCIPAL
       =============================== */
    .welcome-container {
        max-width: 820px;
        margin: 70px auto;
        padding: 55px 45px;
        text-align: center;
        background-color: var(--surface-color);
        border-radius: 18px;
        border: 1px solid var(--border-color);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    }

    /* ===============================
       TEXTOS
       =============================== */
    .welcome-title {
        font-size: 2.6rem;
        font-weight: 800;
        margin: 0 0 12px;
        color: var(--text-main);
    }

    .welcome-greeting {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--primary);
        margin: 0 0 22px;
    }

    .welcome-subtitle {
        font-size: 1.15rem;
        color: var(--text-muted);
        margin-bottom: 40px;
        line-height: 1.7;
    }

    /* ===============================
       BOTONES
       =============================== */
    .action-group {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-block;
        padding: 14px 30px;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        border-radius: 12px;
        border: 2px solid transparent;
        transition: all 0.25s ease;
        cursor: pointer;
    }

    /* Botón principal */
    .btn-primary {
        background-color: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(79, 140, 255, 0.35);
    }

    /* Botón secundario */
    .btn-secondary {
        background-color: transparent;
        color: var(--secondary);
        border-color: var(--secondary);
    }

    .btn-secondary:hover {
        background-color: var(--secondary);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(124, 108, 255, 0.35);
    }

    /* ===============================
       RESPONSIVE
       =============================== */
    @media (max-width: 600px) {
        .welcome-container {
            margin: 40px 15px;
            padding: 40px 25px;
        }

        .welcome-title {
            font-size: 2.1rem;
        }
    }

</style>

<main>
    <div class="welcome-container">
        <%if(userId!== null){%>
        <h2 class="welcome-title"> Ongi etorri <%=izena%>! </h2>
        <p class="welcome-subtitle">Lortuko duzu jakitea zein den gaurko jokalaria?</p>

        <%}else{%>
            <h2 class="welcome-title"> Ongi etorri! </h2>
            <p class="welcome-subtitle">Lortuko duzu jakitea zein den gaurko jokalaria?</p>
        <%}%>


        <% if (role=== 'admin') { %>

            <div class="action-group">
                <a href="/admin" class="btn btn-primary">Admin</a>
                <a href="/play" class="btn btn-secondary">Jolastu</a>
            </div>

        <% } else { %>
        <%if(userId=== null){%>

            <div class="action-group">
                <a href="/auth/login" class="btn btn-primary">Saioa Hasi</a>
                <a href="/auth/register" class="btn btn-secondary">Kontua Sortu</a>
                <a href="/play" class="btn btn-secondary">Jolastu</a>
            </div>
        <%}else{%>
            <div class="action-group">
                <a href="/play" class="btn btn-secondary">Jolastu</a>
            </div>
        <%}%>

        <% } %>

    </div>
</main>

<%- include('partials/footer') %>